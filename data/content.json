    "pages": {
        "template": {
            "title": "Template — Composants",
            "toc": [
                {
                    "label": "Titres et paragraphes",
                    "href": "#typo"
                },
                {
                    "label": "Alertes",
                    "href": "#alertes"
                },
                {
                    "label": "Image d'introduction",
                    "href": "#intro-img"
                },
                {
                    "label": "Image avec légende",
                    "href": "#info-img"
                },
                {
                    "label": "Tableau",
                    "href": "#tableau"
                },
                {
                    "label": "Bloc à copier",
                    "href": "#copy"
                },
                {
                    "label": "Cartes",
                    "href": "#cartes"
                },
                {
                    "label": "Formulaire",
                    "href": "#formulaire"
                }
            ],
            "content": [
                {
                    "type": "h1",
                    "text": "Template — Composants"
                },
                {
                    "type": "h2",
                    "id": "typo",
                    "text": "Titres et paragraphes"
                },
                {
                    "type": "p",
                    "text": "Ceci est un paragraphe standard. Il peut contenir du texte long décrivant une notion, un contexte ou une instruction à destination de l'animateur ou de l'élève. La lisibilité est au cœur du design."
                },
                {
                    "type": "h3",
                    "text": "Sous-titre de niveau 3"
                },
                {
                    "type": "p",
                    "text": "Les titres h3 permettent de structurer des sous-sections sans créer une entrée dans la table des matières. Utile pour organiser du contenu dense."
                },
                {
                    "type": "h2",
                    "id": "alertes",
                    "text": "Alertes"
                },
                {
                    "type": "alertInfo",
                    "variant": "info",
                    "text": "Info : ceci est une alerte de type information. Elle attire l'attention sur un conseil ou une remarque pédagogique sans caractère d'urgence."
                },
                {
                    "type": "alertInfo",
                    "variant": "error",
                    "text": "Attention : ceci est une alerte de type erreur. Elle signale un point critique à ne pas manquer lors de l'animation."
                },
                {
                    "type": "h2",
                    "id": "intro-img",
                    "text": "Image d'introduction"
                },
                {
                    "type": "p",
                    "text": "Le composant introImg affiche une image en pleine largeur avec un titre et une description en overlay. Il sert de visuel d'accroche en tête de page."
                },
                {
                    "type": "introImg",
                    "title": "Titre de la page d'introduction",
                    "description": "Une courte description qui accompagne l'image d'accroche et donne le contexte de la section."
                },
                {
                    "type": "h2",
                    "id": "info-img",
                    "text": "Image avec légende"
                },
                {
                    "type": "p",
                    "text": "Le composant infoImg affiche une image accompagnée d'une légende. Si plusieurs infoImg se suivent, elles s'affichent côte à côte en desktop."
                },
                {
                    "type": "infoImg",
                    "src": "assets/img/couloir.png",
                    "alt": "Photo de la pièce 1",
                    "caption": "Pièce 1 : vue de la première salle de fouille."
                },
                {
                    "type": "infoImg",
                    "src": "assets/img/couloir-copy-0.png",
                    "alt": "Photo de la pièce 2",
                    "caption": "Pièce 2 : seconde salle visible côte à côte en desktop."
                },
                {
                    "type": "p",
                    "text": "Exemple avec une seule infoImg : l'image prend toute la largeur disponible, avec légende sous l'image."
                },
                {
                    "type": "infoImg",
                    "src": "assets/img/bureau.png",
                    "alt": "Bureau vu en grand angle",
                    "caption": "Lorem ipsum dolor sit amet."
                },
                {
                    "type": "h2",
                    "id": "tableau",
                    "text": "Tableau"
                },
                {
                    "type": "p",
                    "text": "Les tableaux permettent de présenter des données comparatives ou des listes structurées. Ils s'adaptent à la largeur du contenu."
                },
                {
                    "type": "table",
                    "headers": [
                        "Phase",
                        "Durée",
                        "Objectif"
                    ],
                    "rows": [
                        [
                            "Lancement",
                            "10 min",
                            "Présenter le contexte et distribuer les rôles"
                        ],
                        [
                            "Enquête",
                            "25 min",
                            "Analyser les indices et formuler des hypothèses"
                        ],
                        [
                            "Résolution",
                            "15 min",
                            "Confronter les conclusions et révéler la vérité"
                        ],
                        [
                            "Débrief",
                            "10 min",
                            "Analyser les biais et tirer les enseignements"
                        ]
                    ]
                },
                {
                    "type": "h2",
                    "id": "copy",
                    "text": "Bloc à copier"
                },
                {
                    "type": "p",
                    "text": "Le composant copyBox permet d'afficher un texte que l'utilisateur peut copier en un clic. Utile pour les instructions, les codes ou les extraits à réutiliser."
                },
                {
                    "type": "copyBox",
                    "text": "Ceci est le texte que l'animateur peut copier directement pour l'envoyer aux participants ou l'intégrer dans un autre support."
                },
                {
                    "type": "h2",
                    "id": "cartes",
                    "text": "Cartes"
                },
                {
                    "type": "p",
                    "text": "Le composant card permet d'afficher une carte avec un titre, un contenu et un lien. Plusieurs cartes peuvent être regroupées dans un cardContainer en grille responsive."
                },
                {
                    "type": "cardContainer",
                    "cards": [
                        {
                            "title": "Phase 1 — Enquête",
                            "content": "Les élèves analysent les preuves et formulent des hypothèses sur l'identité du suspect.",
                            "link": {
                                "href": "enquete-1.html",
                                "label": "Voir la phase"
                            }
                        },
                        {
                            "title": "Phase 2 — Résolution",
                            "content": "Un retournement de situation vient bouleverser les certitudes et force à reconsidérer l'ensemble.",
                            "link": {
                                "href": "resolution.html",
                                "label": "Voir la phase"
                            }
                        },
                        {
                            "title": "Matériel nécessaire",
                            "content": "Liste du matériel à préparer avant la séance : preuves, fiches d'analyse, conteneur à code.",
                            "link": {
                                "href": "materiel.html",
                                "label": "Voir le matériel"
                            }
                        }
                    ]
                },
                {
                    "type": "h2",
                    "id": "formulaire",
                    "text": "Formulaire"
                },
                {
                    "type": "p",
                    "text": "Le composant form génère un formulaire de contact complet avec validation côté client et gestion des erreurs."
                },
                {
                    "type": "form",
                    "action": "https://formspree.io/f/mbdeleeb",
                    "description": "Tous les champs sont obligatoires.",
                    "submit": "Envoyer",
                    "fields": [
                        {
                            "id": "name",
                            "type": "text",
                            "label": "Nom"
                        },
                        {
                            "id": "email",
                            "type": "email",
                            "label": "Email"
                        },
                        {
                            "id": "subject",
                            "type": "text",
                            "label": "Sujet"
                        },
                        {
                            "id": "message",
                            "type": "textarea",
                            "label": "Message"
                        }
                    ]
                }
            ]
        }
    }
}